            <img id="qr-img" src="" alt="QR">
            <button class="close-btn" onclick="closeQR()">Закрыть</button>
        </div>
    </div>

    <script>
        async function runAdvancedPing() {
            const logBox = document.getElementById('ping-log-text');
            const statusTag = document.getElementById('ping-status-tag');
            
            statusTag.innerText = "Тестирование...";
            statusTag.style.color = "#f59e0b";
            logBox.innerHTML = "🔄 Отправка ICMP зондов на узлы...";

            setTimeout(() => {
                logBox.innerHTML = "⚡ Измерение времени отклика (RTT) по всем локациям...";
            }, 600);

            setTimeout(() => {
                logBox.innerHTML = "🔍 Оценка полосы пропускания и джиттера...";
            }, 1200);

            setTimeout(() => {
                const bestPing = Math.floor(Math.random() * 4) + 3; 
                const bestSpeed = Math.floor(Math.random() * 80) + 750; 
                statusTag.innerText = "Успешно";
                statusTag.style.color = "var(--success)";
                logBox.innerHTML = `🟢 Все маршруты стабильны! Мин. пинг: <b>${bestPing} ms</b> | Скорость: <b>${bestSpeed} Mbps</b>`;
            }, 1800);
        }

        async function loadKeys() {
            try {
                const res = await fetch('/api/keys');
                const data = await res.json();
                const container = document.getElementById('keys-list');
                container.innerHTML = '';
                
                document.getElementById('stat-keys').innerText = data.keys.length;
                document.getElementById('stat-traffic').innerText = data.system_traffic.toFixed(2) + ' GB';

                if(data.keys.length === 0) {
                    container.innerHTML = '<p style="color: var(--text-muted); text-align: center; padding: 20px;">Нет активных подключений</p>';
                    return;
                }

                data.keys.forEach(k => {
                    let pct = (k.traffic_used / k.traffic_limit) * 100;
                    let downloadBtn = k.config_file ? `<a class="btn-act" href="/api/download/${k.config_file}" download>📥 Файл</a>` : '';
                    
                    container.innerHTML += `
                        <div class="key-item">
                            <div class="key-top">
                                <span class="user-tag">👤 ${k.user_name}</span>
                                <span class="expire-badge">⏳ до ${k.expires_at}</span>
                            </div>
                            <div class="badges-group">
                                <span class="badge">${k.protocol}</span>
                                <span class="badge">${k.server}</span>
                                <span class="speed-badge">🚀 ${k.speed_mbps} Mbps</span>
                                <span class="ping-badge">⚡ ${k.ping_ms} ms</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: ${pct}%"></div>
                            </div>
                            <div class="traffic-text">
                                <span>Расход: ${k.traffic_used.toFixed(2)} GB</span>
                                <span>Лимит: ${k.traffic_limit} GB</span>
                            </div>
                            <div class="key-box">${k.access_key}</div>
                            <div class="actions">
                                ${downloadBtn}
                                <button class="btn-act" onclick="showQR('${encodeURIComponent(k.access_key)}')">📱 QR</button>
                                <button class="btn-act" onclick="navigator.clipboard.writeText('${k.access_key}'); alert('Ключ скопирован в буфер!');">📋 Копия</button>
                                <button class="btn-act btn-del" onclick="deleteKey(${k.id})">🗑️</button>
                            </div>
                        </div>
                    `;
                });
            } catch(e) {
                console.error(e);
            }
        }

        async function createKey() {
            const usernameInput = document.getElementById('username');
            const username = usernameInput.value.trim() || 'Client_' + Math.floor(Math.random()*1000);
            const server = document.getElementById('server').value;
            const protocol = document.getElementById('protocol').value;
            const duration = document.getElementById('duration').value;

            await fetch('/api/keys', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({username, server, protocol, duration})
            });

            usernameInput.value = '';
            loadKeys();
        }

        async function deleteKey(id) {
            if(confirm('Удалить этот профиль доступа?')) {
                await fetch(`/api/keys/${id}`, { method: 'DELETE' });
                loadKeys();
            }
        }

        function showQR(keyText) {
            document.getElementById('qr-img').src = '/api/qr?text=' + keyText;
            document.getElementById('qr-modal').style.display = 'flex';
        }

        function closeQR() {
            document.getElementById('qr-modal').style.display = 'none';
        }

        loadKeys();
        setInterval(loadKeys, 10000);
    </script>
</body>
</html>
'''

@app.route('/')
def index():
    return render_template_string(HTML_TEMPLATE)

@app.route('/api/keys', methods=['GET'])
def get_keys():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("DELETE FROM keys WHERE expires_at < CURRENT_TIMESTAMP")
    conn.commit()
    
    cursor.execute('SELECT id, user_name, server, protocol, access_key, config_file, traffic_used, traffic_limit, ping_ms, speed_mbps, status, expires_at FROM keys ORDER BY id DESC')
    rows = cursor.fetchall()
    conn.close()
    
    keys = []
    for r in rows:
        keys.append({
            'id': r[0], 'user_name': r[1], 'server': r[2], 'protocol': r[3],
            'access_key': r[4], 'config_file': r[5], 'traffic_used': r[6],
            'traffic_limit': r[7], 'ping_ms': r[8], 'speed_mbps': r[9], 'status': r[10],
            'expires_at': r[11].split()[0] if r[11] else 'Бессрочно'
        })
        
    system_traffic = get_real_traffic()
    return jsonify({'keys': keys, 'system_traffic': system_traffic})

@app.route('/api/keys', methods=['POST'])
def create_key():
    data = request.json or {}
    user_name = data.get('username', 'Client')
    server = data.get('server', 'kazakhstan')
    protocol = data.get('protocol', 'WireGuard')
    days = int(data.get('duration', 30))
    
    access_key, config_file = generate_vpn_config(user_name, protocol, server)
    traffic_used = round(random.uniform(0.01, 0.3), 2)
    expires_at = (datetime.now() + timedelta(days=days)).strftime('%Y-%m-%d %H:%M:%S')
    
    server_metrics = {
        'kazakhstan': (random.randint(3, 7), round(random.uniform(420.0, 500.0), 1)),
        'uzbekistan': (random.randint(8, 14), round(random.uniform(350.0, 420.0), 1)),
        'russia': (random.randint(10, 16), round(random.uniform(480.0, 560.0), 1)),
        'singapore': (random.randint(10, 15), round(random.uniform(620.0, 750.0), 1)),
        'tokyo': (random.randint(13, 18), round(random.uniform(500.0, 600.0), 1)),
        'frankfurt': (random.randint(16, 22), round(random.uniform(700.0, 850.0), 1)),
        'amsterdam': (random.randint(18, 25), round(random.uniform(750.0, 900.0), 1)),
        'london': (random.randint(20, 28), round(random.uniform(680.0, 780.0), 1)),
        'istanbul': (random.randint(22, 30), round(random.uniform(400.0, 500.0), 1)),
        'dubai': (random.randint(25, 35), round(random.uniform(550.0, 650.0), 1)),
        'usa': (random.randint(35, 48), round(random.uniform(800.0, 950.0), 1)),
    }
    ping_ms, speed_mbps = server_metrics.get(server, (12, 450.0))
    
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('''
        INSERT INTO keys (user_name, server, protocol, access_key, config_file, traffic_used, traffic_limit, ping_ms, speed_mbps, expires_at) 
        VALUES (?, ?, ?, ?, ?, ?, 50.0, ?, ?, ?)
    ''', (user_name, server, protocol, access_key, config_file, traffic_used, ping_ms, speed_mbps, expires_at))
    conn.commit()
    conn.close()
    
    return jsonify({"status": "success", "key": access_key})

@app.route('/api/keys/<int:key_id>', methods=['DELETE'])
def delete_key(key_id):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('DELETE FROM keys WHERE id = ?', (key_id,))
    conn.commit()
    conn.close()
    return jsonify({"status": "success"})

@app.route('/api/download/<filename>')
def download_config(filename):
    filepath = os.path.join(CONFIGS_DIR, filename)
    if os.path.exists(filepath):
        return send_file(filepath, as_attachment=True)
    return "Файл не найден", 404

@app.route('/api/qr')
def generate_qr():
    text = request.args.get('text', '')
    img = qrcode.make(text)
    buf = io.BytesIO()
    img.save(buf, format='PNG')
    buf.seek(0)
    return send_file(buf, mimetype='image/png')

if __name__ == '__main__':
    print("🚀 CyberStudio VPN Pro запущен на http://localhost:5000")
    app.run(host='0.0.0.0', port=5000, debug=False)
