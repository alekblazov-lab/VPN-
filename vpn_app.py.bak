app = Flask(__name__)
DB_PATH = 'vpn.db'
CONFIGS_DIR = 'configs'

os.makedirs(CONFIGS_DIR, exist_ok=True)

def init_db():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS keys (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_name TEXT NOT NULL,
            server TEXT NOT NULL,
            protocol TEXT NOT NULL,
            access_key TEXT NOT NULL,
            config_file TEXT,
            traffic_used REAL DEFAULT 0.0,
            traffic_limit REAL DEFAULT 50.0,
            ping_ms INTEGER DEFAULT 12,
            speed_mbps REAL DEFAULT 340.0,
            status TEXT DEFAULT 'DISCONNECTED',
            expires_at TIMESTAMP,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    conn.commit()
    conn.close()

init_db()

def get_real_traffic():
    try:
        if os.path.exists('/proc/net/dev'):
            with open('/proc/net/dev', 'r') as f:
                lines = f.readlines()
                for line in lines:
                    if 'wlan0' in line or 'eth0' in line or 'rmnet' in line:
                        parts = line.split()
                        rx_bytes = int(parts[1])
                        tx_bytes = int(parts[9])
                        total_gb = (rx_bytes + tx_bytes) / (1024 ** 3)
                        return round(total_gb, 3)
    except Exception:
        pass
    return 0.38

def generate_vpn_config(username, protocol, server):
    random_str = ''.join(random.choices(string.ascii_lowercase + string.digits, k=16))
    
    if protocol == 'WireGuard':
        try:
            private_key = subprocess.check_output(['wg', 'genkey']).decode('utf-8').strip()
            public_key = subprocess.check_output(['wg', 'pubkey'], input=private_key.encode()).decode('utf-8').strip()
        except Exception:
            private_key = ''.join(random.choices(string.ascii_letters + string.digits, k=44))
            public_key = "server_public_key_placeholder=="

        address_ip = f"10.10.0.{random.randint(2, 250)}"
        
        config_content = f"""[Interface]
PrivateKey = {private_key}
Address = {address_ip}/32
DNS = 1.1.1.1, 8.8.8.8

[Peer]
PublicKey = {public_key}
Endpoint = {server}.vpn.net:51820
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25
"""
        filename = f"{username}_{server}.conf"
        filepath = os.path.join(CONFIGS_DIR, filename)
        with open(filepath, 'w') as f:
            f.write(config_content)
            
        return f"wireguard://config-{username}", filename

    elif protocol == 'VLESS':
        return f"vless://{random_str}@{server}.vpn.net:443?encryption=none&security=reality&type=tcp&sni=cloudflare.com#VPN-{username}", None
        
    elif protocol == 'Trojan':
        return f"trojan://{random_str}@{server}.vpn.net:8443?security=tls&sni=cloudflare.com#VPN-{username}", None

    elif protocol == 'OpenVPN':
        ovpn_content = f"""client
dev tun
proto udp
remote {server}.vpn.net 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth SHA256
<cert>
-----BEGIN CERTIFICATE-----
MIIF...[client_cert_placeholder]...
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
MIIE...[client_key_placeholder]...
-----END PRIVATE KEY-----
</key>
"""
        filename = f"{username}_{server}.ovpn"
        filepath = os.path.join(CONFIGS_DIR, filename)
        with open(filepath, 'w') as f:
            f.write(ovpn_content)
        return f"openvpn://config-{username}", filename
        
    else:
        ss_raw = f"chacha20-poly1305:{random_str}@{server}.vpn.net:8388"
        encoded_ss = base64.b64encode(ss_raw.encode()).decode()
        return f"ss://{encoded_ss}#VPN-{username}", None

